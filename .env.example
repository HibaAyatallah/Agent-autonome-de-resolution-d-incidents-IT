APP_ENV=development
DATABASE_URL=sqlite:///./data/incidents.db
SIMILAR_CASE_LIMIT=5
SIMILAR_CASE_MINIMUM_SCORE=0.25
REMEDIATION_DRY_RUN=true
# Optional: enables the human approve/reject endpoint. Keep secret and set reviewer identity too.
REMEDIATION_APPROVAL_TOKEN=
REMEDIATION_APPROVER_ID=
# Optional JSON array for separate reviewer identities (each token must be at least 32 characters).
# Example: REMEDIATION_REVIEWERS='[{"reviewer_id":"reviewer-1","token":"replace-with-32-random-characters"}]'
REMEDIATION_REVIEWERS=[]
MAX_DIAGNOSTIC_CYCLES=2
AGENT_TIMEOUT_SECONDS=5
MAX_AGENT_ATTEMPTS=2
# Leave empty to use deterministic, rule-based reasoning only.
LLM_API_KEY=

# Resource thresholds (percent); each warning value must be below critical.
MONITOR_CPU_WARNING=80
MONITOR_CPU_CRITICAL=95
MONITOR_RAM_WARNING=85
MONITOR_RAM_CRITICAL=95
MONITOR_DISK_WARNING=85
MONITOR_DISK_CRITICAL=95

# Optional allowlist of TCP checks. Format: name=host:port,name=host:port
INCIDENT_NETWORK_TARGETS=
